# Caddy edge config for the Hail self-host VM.
#
# Public hostnames:
#   api.{$HAIL_DOMAIN}        → api:8080   (FastAPI / OpenAPI)
#   mcp.{$HAIL_DOMAIN}        → mcp:8081   (MCP, Streamable HTTP)
#   {$HAIL_TRACKING_DOMAIN}   → SES open/click tracking server (optional)
#
# Auto-HTTPS: Caddy fetches Let's Encrypt certs on first start and renews
# them in the background. The TLS-ALPN-01 challenge is used (no DNS plumbing),
# so :443 must be open on the VM firewall in addition to :80.
#
# Voicebot intentionally has no ingress — it's a worker that dials out to
# LiveKit Cloud.

{
	# Default set in docker-compose.prod.yml; override CADDY_ACME_EMAIL in
	# .env if you want renewal notices to reach your own inbox.
	email {$CADDY_ACME_EMAIL}
}

api.{$HAIL_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080 {
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
	}
}

mcp.{$HAIL_DOMAIN} {
	encode zstd gzip
	# MCP streams responses (Streamable HTTP, and legacy SSE) — disable
	# response buffering so events stream end-to-end without Caddy holding them.
	reverse_proxy mcp:8081 {
		flush_interval -1
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
	}
}

# Email open/click tracking links on your own host name instead of
# awstrack.me (docs/public/self-host/aws-ses.md → "Tracking domain").
# SES picks the configuration set from the Host header, so the header is
# passed through unchanged; the TLS name must stay the SES host or the
# upstream certificate check fails. Unset → the block binds the unused
# `tracking.localhost` name (internal certificate, no ACME request).
{$HAIL_TRACKING_DOMAIN:tracking.localhost} {
	reverse_proxy https://r.{$AWS_REGION:us-east-1}.awstrack.me {
		header_up Host {host}
		transport http {
			tls_server_name r.{$AWS_REGION:us-east-1}.awstrack.me
		}
	}
}
