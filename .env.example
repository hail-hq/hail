# =============================================================================
# Hail — environment configuration
# =============================================================================
# Copy this file:
#   cp .env.example .env        # for docker compose / production
#   cp .env.example .env.local  # for local dev on the host
# .env and .env.local are gitignored; .env.example is the only one committed.

# ─── Hail core ───────────────────────────────────────────────────────────────

# Self-host shared-key auth (generate: openssl rand -base64 32). Empty in cloud.
HAIL_API_KEY=
HAIL_API_URL=http://localhost:8080

# Signs GET /unsubscribe tokens (generate: openssl rand -base64 32). A
# dedicated secret — do NOT reuse HAIL_INTERNAL_SECRET below, which signs a
# different thing (internal API<->website calls).
HAIL_UNSUBSCRIBE_SECRET=

# Encrypts stored provider API keys (BYO) and per-call LLM keys in transit
# through LiveKit dispatch metadata (generate: python -c "from
# hailhq.core.secret_cipher import generate_key; print(generate_key())").
# Optional for self-host; without it, per-call llm.api_key falls back to
# the legacy plaintext dispatch path.
HAIL_PROVIDER_SECRET_KEY=

# Cloud only — hail-website base + internal HMAC for API↔website signing.
# Bidirectional: signs hail -> website calls (usage-events rater) AND
# authenticates website -> hail calls (POST /internal/org-closures,
# POST /internal/dsar/*) via the same X-Hail-Signature scheme.
HAIL_BASE_URL=
HAIL_INTERNAL_SECRET=

# Cloud only — Better Auth JWT issuer + accepted audiences.
HAIL_AUTH_URL=
HAIL_AUTH_AUDIENCES=

# Cloud only — public MCP URL for OAuth resource discovery.
MCP_RESOURCE_URL=

# Overrides the derived MCP endpoint URL. Self-host operators set this; for
# Hail Cloud the CLI derives `mcp.<host>.so` (root path; no /mcp suffix —
# see docs/setup/mcp.md) from $HAIL_API_URL.
HAIL_MCP_URL=

# Prod overlay only (`-f docker-compose.prod.yml`). See docs/setup/vm-deploy.md.
HAIL_DOMAIN=
CADDY_ACME_EMAIL=

# ─── Database ────────────────────────────────────────────────────────────────

# Bundled Postgres (default):
DATABASE_URL=postgresql://hail:hail@postgres:5432/hail
# Managed (Neon / Supabase / RDS / …):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ─── AWS ─────────────────────────────────────────────────────────────────────

# Single IAM identity used by every Hail service. Provisioned by terragrunt:
#   AWS_ACCESS_KEY_ID     ← `terragrunt output -raw iam_access_key_id`
#   AWS_SECRET_ACCESS_KEY ← `terragrunt output -raw iam_secret_access_key`
# Leave empty on EC2/ECS/EKS with an attached IAM role.
# AWS_PROFILE is operator-only — set it in your shell, not here, or
# containerized services crash with ProfileNotFound.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Terragrunt remote state. Pre-create bucket + lock table once per AWS account.
HAIL_TERRAFORM_STATE_BUCKET=
HAIL_TERRAFORM_LOCK_TABLE=
HAIL_TERRAFORM_STATE_REGION=
HAIL_INBOUND_EMAIL_NAME_PREFIX=hail-email-inbound

# IAM user the Hail policy attaches to. Terragrunt auto-detects whether
# it exists — created if missing, referenced if found.
HAIL_IAM_USER_NAME=hail

# ─── LLM providers ───────────────────────────────────────────────────────────

OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_APPLICATION_CREDENTIALS=
# Base64-encoded SA JSON for Docker. Decoded to a temp file at startup.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_CLOUD_PROJECT=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Voice ───────────────────────────────────────────────────────────────────

# LiveKit Cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_SIP_INBOUND_TRUNK_ID=

# Deepgram (STT)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Cartesia (primary TTS) — CARTESIA_VOICE_ID is required at runtime.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.5

# ElevenLabs (fallback TTS) — optional; used only when ELEVEN_API_KEY is set.
ELEVEN_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Twilio (PSTN)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Voice soft-cap. 0 disables.
HAIL_VOICE_MAX_DURATION_SECONDS=300
# Pool-number sweeper grace before force-releasing a stuck reservation.
HAIL_POOL_RELEASE_GRACE_SECONDS=120

# ─── Email ───────────────────────────────────────────────────────────────────

# Outbound — operator-managed parent domain. Verify with SES once, out of band.
HAIL_MAIL_BASE_DOMAIN=
# Self-host shortcut (SINGLE org only): full From address. Do not set on a
# multi-tenant deployment — every org would collide on this one address.
HAIL_MAIL_FROM=
# Default USER prefix when a request omits local_prefix_user. The org prefix
# is always derived per-org from the organization id, never a constant.
HAIL_MAIL_DEFAULT_USER_PREFIX=

# SES configuration set for delivery/engagement event tracking (must match
# the Terraform-provisioned set; empty disables event publishing)
HAIL_SES_CONFIGURATION_SET=

# Auto-poll cadence (seconds) for pending custom sender domains. 0 disables.
HAIL_DOMAIN_VERIFY_POLL_SECONDS=120

# Inbound — off by default. Bucket name is derived as `${prefix}-raw`
# from HAIL_INBOUND_EMAIL_NAME_PREFIX above; Terraform creates that bucket
# and the API reads from it — single source, no drift.
HAIL_INBOUND_ENABLED=false
HAIL_INBOUND_HMAC_SECRET=
HAIL_FORWARD_MAX_HOPS=3
HAIL_FORWARD_RATE_PER_HOUR=200
HAIL_INBOUND_ORG_RATE_PER_HOUR=1000
# Dev only.
HAIL_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Fernet key for at-rest webhook-secret encryption. Generate:
#   uv run --directory core python -c "from hailhq.core.secret_cipher import generate_key; print(generate_key())"
HAIL_WEBHOOK_SECRET_KEY=

# ─── Gmail account connection ─────────────────────────────────────────────────

# OAuth client credentials of the operator's Google Cloud app. The hosted app
# is verified for gmail.send + gmail.readonly scopes. Self-hosters register
# their own (an internal Workspace app needs no Google review). Empty = connect
# endpoints return 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the browser lands after a successful connect. Empty = minimal HTML page.
HAIL_EMAIL_CONNECT_SUCCESS_URL=

# ─── Compliance gate (hailhq.core.compliance_gate) ───────────────────────────

# US National Do Not Call registry (donotcall.gov) scrub. Off by default —
# there is no live vendor integration yet (requires a paid subscription).
HAIL_NATIONAL_DNC_ENABLED=false

# CSV of E.164 prefixes to block outright (premium-rate / high-risk
# destinations). Empty = no prefix blocking. Illustrative examples only —
# the complete list is an ops decision:
# HAIL_BLOCKED_E164_PREFIXES=+1900,+1976

# Velocity / new-account caps — flat defaults, adjustable per deployment
# (a per-tier scheme is out of scope for now).
HAIL_VELOCITY_CALL_PER_HOUR=20
HAIL_VELOCITY_CALL_PER_DAY=200
HAIL_VELOCITY_EMAIL_PER_HOUR=50
HAIL_VELOCITY_EMAIL_PER_DAY=500
HAIL_VELOCITY_SMS_PER_HOUR=100
HAIL_VELOCITY_SMS_PER_DAY=1000

# Poll cadence (seconds) for the SMS abuse-monitoring guardrail (opt-out
# rate -> ChannelSuspension). Hourly by default; a coarse-grained batch
# check, not a per-send check. 0 disables the worker.
HAIL_ABUSE_MONITOR_POLL_SECONDS=3600

# SMS abuse thresholds: rolling window (hours), minimum sends in that window
# before an org is eligible to be flagged (floor for low-volume orgs), and
# the opt-out rate that trips a ChannelSuspension.
HAIL_SMS_ABUSE_WINDOW_HOURS=24
HAIL_SMS_ABUSE_MIN_SENDS=20
HAIL_SMS_ABUSE_MAX_OPT_OUT_RATE=0.05

# SMS compliance auto-replies (HELP/STOP/START). OFF by default — Twilio
# already auto-replies to these keywords, so turning this on without first
# disabling Twilio's own opt-out handling double-texts recipients. The STOP
# suppression record is written regardless.
HAIL_SMS_COMPLIANCE_REPLIES_ENABLED=false

# ─── Call recordings (S3-compatible — MinIO in dev) ──────────────────────────

S3_ENDPOINT=http://minio:9000
S3_BUCKET=hail-recordings
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
