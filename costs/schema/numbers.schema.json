{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hail.so/costs/schema/numbers.json",
  "title": "Number Catalog",
  "description": "One carrier's phone-number catalog: monthly price, capabilities (calls, texts, MMS) and whether the buyer must be verified first, per country and number type. Prices are at-cost pass-through. Twilio's file also carries the A2P 10DLC fee table.",
  "type": "object",
  "required": ["version", "license", "provider", "numbers"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 3
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "provider": {
      "enum": ["twilio", "telnyx", "didww"]
    },
    "numbers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/number"
      }
    },
    "a2p_10dlc": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fee"
      }
    },
    "regulatory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phone_setup_required", "sms_registration_required"],
      "properties": {
        "note": {
          "type": "string"
        },
        "phone_setup_required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}:(local|mobile|toll_free|national)$"
          }
        },
        "sms_registration_required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
      }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "number": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "number_type",
        "display_name",
        "usd_per_month",
        "last_verified",
        "last_changed_at",
        "verification_method",
        "verified_by",
        "source_url",
        "voice",
        "sms",
        "mms",
        "dial_code",
        "verification_required",
        "available"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "number_type": {
          "enum": ["local", "mobile", "toll_free", "national"]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "usd_per_month": {
          "$ref": "#/$defs/decimal"
        },
        "last_verified": {
          "$ref": "#/$defs/date"
        },
        "last_changed_at": {
          "$ref": "#/$defs/date"
        },
        "verification_method": {
          "enum": ["manual-confirmed", "community-pr", "carrier-sync"]
        },
        "verified_by": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9])){0,38}$"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "voice": {
          "type": "boolean"
        },
        "sms": {
          "type": "boolean"
        },
        "mms": {
          "type": "boolean"
        },
        "verification_required": {
          "type": "boolean",
          "description": "The buyer must be verified (ID, address or regulatory bundle) before this number can be bought."
        },
        "available": {
          "type": "boolean",
          "description": "The carrier offers this number type today. false keeps a row (held numbers stay billable) but hides it from the picker."
        },
        "setup_usd": {
          "$ref": "#/$defs/decimal",
          "description": "One-time price, when the carrier charges one."
        },
        "dial_code": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["voice"],
          "properties": {
            "voice": {
              "const": true
            }
          }
        },
        {
          "required": ["sms"],
          "properties": {
            "sms": {
              "const": true
            }
          }
        }
      ]
    },
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "fee_kind",
        "direction",
        "last_verified",
        "last_changed_at",
        "verification_method",
        "verified_by",
        "source_url"
      ],
      "anyOf": [
        {
          "required": ["usd_per_message"]
        },
        {
          "required": ["usd_per_month"]
        },
        {
          "required": ["usd_one_time"]
        }
      ],
      "properties": {
        "carrier": {
          "type": "string",
          "minLength": 1
        },
        "fee_kind": {
          "enum": [
            "carrier_passthrough",
            "tcr_registration",
            "tcr_campaign_monthly"
          ]
        },
        "direction": {
          "enum": ["outbound", "inbound", "na"]
        },
        "usd_per_message": {
          "$ref": "#/$defs/decimal"
        },
        "usd_per_month": {
          "$ref": "#/$defs/decimal"
        },
        "usd_one_time": {
          "$ref": "#/$defs/decimal"
        },
        "last_verified": {
          "$ref": "#/$defs/date"
        },
        "last_changed_at": {
          "$ref": "#/$defs/date"
        },
        "verification_method": {
          "enum": ["manual-confirmed", "community-pr", "carrier-sync"]
        },
        "verified_by": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9])){0,38}$"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
