{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hail.so/costs/schema/tts.json",
  "title": "TTS Costs",
  "description": "Cost and capability data for text-to-speech providers.",
  "type": "object",
  "required": ["version", "license", "models"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "license": { "const": "CC-BY-4.0" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "display_name",
        "voice_quality",
        "languages",
        "last_verified",
        "last_changed_at",
        "verification_method",
        "verified_by",
        "source_url"
      ],
      "anyOf": [
        { "required": ["price_per_1m_chars_usd"] },
        { "required": ["price_per_second_usd"] }
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "provider_url": { "type": "string", "format": "uri" },
        "model_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "price_per_1m_chars_usd": { "$ref": "#/$defs/decimal" },
        "price_per_second_usd": { "$ref": "#/$defs/decimal" },
        "voice_quality": { "enum": ["standard", "neural", "cloned"] },
        "voice_count": { "type": "integer", "minimum": 1 },
        "voices_count": { "type": "integer", "minimum": 1 },
        "voices_premium_count": { "type": "integer", "minimum": 0 },
        "languages": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            { "type": "string", "pattern": "^[0-9]+\\+$" }
          ]
        },
        "ssml_supported": { "type": "boolean" },
        "emotion_control_supported": { "type": "boolean" },
        "streaming_supported": { "type": "boolean" },
        "voice_cloning": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["price_usd", "unit"],
              "properties": {
                "price_usd": { "$ref": "#/$defs/decimal" },
                "unit": { "enum": ["per-clone", "monthly", "per-1m-chars"] },
                "min_seconds": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "output_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "sample_rates_hz": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "time_to_first_byte_ms": { "type": "integer", "minimum": 0 },
        "min_billed_chars": { "type": "integer", "minimum": 0 },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "deployment_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "native",
              "bedrock",
              "vertex",
              "azure",
              "together",
              "fireworks",
              "groq",
              "replicate",
              "dashscope",
              "openrouter"
            ]
          }
        },
        "aggregators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["openrouter"]
          }
        },
        "free_tier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests_per_day": { "type": "integer", "minimum": 0 },
            "tokens_per_day": { "type": "integer", "minimum": 0 }
          }
        },
        "deprecated_at": { "type": "string", "format": "date" },
        "replaced_by_model_id": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "last_verified": { "type": "string", "format": "date" },
        "last_changed_at": { "type": "string", "format": "date" },
        "verification_method": { "enum": ["manual-confirmed", "community-pr"] },
        "verified_by": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9])){0,38}$"
        },
        "source_url": { "type": "string", "format": "uri" },
        "notes": { "type": "string" }
      }
    }
  }
}
