{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hail.so/costs/schema/llm.json",
  "title": "LLM Costs",
  "description": "Cost and capability data for large language model providers.",
  "type": "object",
  "required": ["version", "license", "models"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "license": { "const": "CC-BY-4.0" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "display_name",
        "context_window",
        "max_output_tokens",
        "input_per_mtok_usd",
        "output_per_mtok_usd",
        "modalities",
        "last_verified",
        "last_changed_at",
        "verification_method",
        "verified_by",
        "source_url"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "provider_url": { "type": "string", "format": "uri" },
        "model_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "model_family": { "type": "string" },
        "release_date": { "type": "string", "format": "date" },
        "knowledge_cutoff": { "type": "string", "format": "date" },
        "context_window": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "input_per_mtok_usd": { "$ref": "#/$defs/decimal" },
        "output_per_mtok_usd": { "$ref": "#/$defs/decimal" },
        "cache_read_per_mtok_usd": { "$ref": "#/$defs/decimal" },
        "cache_write_per_mtok_usd": { "$ref": "#/$defs/decimal" },
        "cache_storage_per_mtok_per_hour_usd": { "$ref": "#/$defs/decimal" },
        "per_request_usd": { "$ref": "#/$defs/decimal" },
        "per_search_usd": { "$ref": "#/$defs/decimal" },
        "batch_input_per_mtok_usd": { "$ref": "#/$defs/decimal" },
        "batch_output_per_mtok_usd": { "$ref": "#/$defs/decimal" },
        "pricing_tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threshold_tokens",
              "input_per_mtok_usd",
              "output_per_mtok_usd"
            ],
            "properties": {
              "threshold_tokens": { "type": "integer", "minimum": 1 },
              "input_per_mtok_usd": { "$ref": "#/$defs/decimal" },
              "output_per_mtok_usd": { "$ref": "#/$defs/decimal" },
              "cache_read_per_mtok_usd": { "$ref": "#/$defs/decimal" }
            }
          }
        },
        "reasoning_tokens_billed": { "type": "boolean" },
        "supports_tool_use": { "type": "boolean" },
        "structured_output": { "type": "boolean" },
        "supports_vision": { "type": "boolean" },
        "supports_audio_in": { "type": "boolean" },
        "supports_audio_out": { "type": "boolean" },
        "supports_pdf": { "type": "boolean" },
        "modalities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output"],
          "properties": {
            "input": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["text", "image", "audio", "video"] }
            },
            "output": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["text", "image", "audio"] }
            }
          }
        },
        "latency_benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_url", "measured_at"],
          "properties": {
            "source_url": { "type": "string", "format": "uri" },
            "ttft_ms": { "type": "integer", "minimum": 0 },
            "output_tps": { "type": "number", "minimum": 0 },
            "measured_at": { "type": "string", "format": "date" },
            "confidence": { "enum": ["high", "medium", "low"] }
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "deployment_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "native",
              "bedrock",
              "vertex",
              "azure",
              "together",
              "fireworks",
              "groq",
              "replicate",
              "dashscope",
              "openrouter"
            ]
          }
        },
        "free_tier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests_per_day": { "type": "integer", "minimum": 0 },
            "tokens_per_day": { "type": "integer", "minimum": 0 }
          }
        },
        "deprecated_at": { "type": "string", "format": "date" },
        "replaced_by_model_id": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "last_verified": { "type": "string", "format": "date" },
        "last_changed_at": { "type": "string", "format": "date" },
        "verification_method": { "enum": ["manual-confirmed", "community-pr"] },
        "verified_by": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9])){0,38}$"
        },
        "source_url": { "type": "string", "format": "uri" },
        "notes": { "type": "string" }
      }
    }
  }
}
