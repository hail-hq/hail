{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hail.so/costs/schema/sms.json",
  "title": "SMS Costs",
  "description": "Provider base rates for outbound SMS per message segment (US long code / 10DLC). Base rates only — A2P carrier pass-through fees live in telephony.json's a2p_10dlc section and are additional for every provider.",
  "type": "object",
  "required": ["version", "license", "providers"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "license": { "const": "CC-BY-4.0" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rate" }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "country_code",
        "direction",
        "usd_per_segment",
        "last_verified",
        "last_changed_at",
        "verification_method",
        "verified_by",
        "source_url"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "direction": { "enum": ["outbound", "inbound"] },
        "usd_per_segment": { "$ref": "#/$defs/decimal" },
        "last_verified": { "$ref": "#/$defs/date" },
        "last_changed_at": { "$ref": "#/$defs/date" },
        "verification_method": { "enum": ["manual-confirmed", "community-pr"] },
        "verified_by": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "notes": { "type": "string" }
      }
    }
  }
}
